{
  "$ref": "#/definitions/mcq",
  "definitions": {
    "mcq": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "mcq"
        },
        "subjectCode": {
          "type": "string",
          "enum": [
            "HIST",
            "POL",
            "ECON",
            "GEO",
            "SCI",
            "MENT",
            "CA",
            "TEL",
            "ENG"
          ]
        },
        "topic": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "subjectCode": {
                "$ref": "#/definitions/mcq/properties/subjectCode"
              },
              "syllabusRef": {
                "type": "string"
              },
              "subtopicId": {
                "type": "string"
              },
              "tier": {
                "type": "number",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "covers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refresher": {
                "type": "boolean"
              },
              "question": {
                "type": "string"
              },
              "match": {
                "type": "object",
                "properties": {
                  "leftTitle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rightTitle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "left": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "enum": [
                            "A",
                            "B",
                            "C",
                            "D",
                            "E",
                            "F"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "key",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 2,
                    "maxItems": 6
                  },
                  "right": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "enum": [
                            "1",
                            "2",
                            "3",
                            "4",
                            "5",
                            "6"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "key",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 2,
                    "maxItems": 6
                  }
                },
                "required": [
                  "leftTitle",
                  "rightTitle",
                  "left",
                  "right"
                ],
                "additionalProperties": false
              },
              "statements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 6
              },
              "assertion": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "noteRef": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              "answerIndex": {
                "type": "integer",
                "minimum": 0
              },
              "explanation": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "subjectCode",
              "question",
              "options",
              "answerIndex"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "subjectCode",
        "topic",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

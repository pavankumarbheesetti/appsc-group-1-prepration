{
  "$ref": "#/definitions/manifest",
  "definitions": {
    "manifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "banks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "mcq",
                  "notes",
                  "mains",
                  "syllabus",
                  "cards",
                  "mindmap"
                ]
              },
              "subjectCode": {
                "type": "string",
                "enum": [
                  "HIST",
                  "POL",
                  "ECON",
                  "GEO",
                  "SCI",
                  "MENT",
                  "CA",
                  "TEL",
                  "ENG"
                ]
              },
              "topic": {
                "type": "string"
              },
              "subtopicId": {
                "type": "string"
              },
              "count": {
                "type": "number"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "count",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "banks"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

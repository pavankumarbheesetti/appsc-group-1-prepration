    {"id":"econ-agriculture-card-2","subjectCode":"ECON","subtopicId":"econ-agriculture","front":"Kharif vs Rabi vs Zaid — sowing and examples?","back":"Kharif (rice/cotton, Jun-Jul), Rabi (wheat/gram, Oct-Dec), Zaid (watermelon, summer).","examPoint":"Cropping seasons","source":"notes","verified":true},
    {"id":"econ-agriculture-card-3","subjectCode":"ECON","subtopicId":"econ-agriculture","front":"Who led India's Green Revolution and with what inputs?","back":"M.S. Swaminathan (with Borlaug's work); HYV seeds, fertiliser, irrigation (post-1965).","examPoint":"Green Revolution — Swaminathan, HYV","source":"notes","verified":true},
    {"id":"econ-agriculture-card-4","subjectCode":"ECON","subtopicId":"econ-agriculture","front":"Coloured revolutions: White, Blue, Yellow, Pink?","back":"White=milk (Operation Flood, Kurien), Blue=fish, Yellow=oilseeds, Pink=meat/prawn.","examPoint":"Coloured revolutions","source":"notes","verified":true},
    {"id":"econ-agriculture-card-5","subjectCode":"ECON","subtopicId":"econ-agriculture","front":"Who led the Bhoodan Movement and when?","back":"Acharya Vinoba Bhave, 1951; first donation by V. Ramachandra Reddy.","examPoint":"Bhoodan Movement 1951 — Vinoba Bhave","source":"notes","verified":true},

  "topic": "Salient Features & the Preamble",
  "items": [
    {"id":"pol-constitution-features-preamble-card-1","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Original size of the Constitution (1949)?","back":"395 Articles, 22 Parts, 8 Schedules (now about 470/25/12).","examPoint":"Lengthiest written constitution — original vs current count","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-2","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Which article calls India a 'Union of States'?","back":"Article 1 — implies no right to secede; word 'Federation' is never used.","examPoint":"Quasi-federal; Art 1 Union of States","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-3","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Borrowed: Fundamental Rights & judicial review from?","back":"United States (also VP's post, independence of judiciary).","examPoint":"Sources borrowed — US","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-4","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Borrowed: DPSP and Fundamental Duties from?","back":"DPSP — Ireland; Fundamental Duties — USSR (Soviet).","examPoint":"Sources borrowed — Irish DPSP, Soviet FD","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-5","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"The Preamble is based on which document?","back":"The Objectives Resolution, moved by Jawaharlal Nehru (1946).","examPoint":"Preamble based on Objectives Resolution","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-6","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Which words did the 42nd Amendment (1976) add to the Preamble?","back":"Socialist, Secular and Integrity.","examPoint":"42nd Amendment added Socialist, Secular, Integrity","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-7","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Five keywords describing the state in the Preamble?","back":"Sovereign, Socialist, Secular, Democratic, Republic.","examPoint":"Preamble keywords describing the state","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-8","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Four objectives in the Preamble?","back":"Justice, Liberty, Equality, Fraternity.","examPoint":"Preamble objectives — JLEF","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-9","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Berubari (1960) vs Kesavananda (1973) on the Preamble?","back":"Berubari: NOT part of the Constitution; Kesavananda: IS part and is amendable.","examPoint":"Preamble status — Berubari vs Kesavananda","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-10","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Is the Preamble enforceable in court?","back":"No — it is non-justiciable (LIC 1995: integral part but not directly enforceable).","examPoint":"Preamble non-justiciable","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-11","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Adoption and commencement dates of the Constitution?","back":"Adopted 26 Nov 1949; came into force 26 Jan 1950.","examPoint":"Adoption 26 Nov 1949, enforced 26 Jan 1950","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-12","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Which Schedule lists official languages and how many?","back":"8th Schedule — 22 languages.","examPoint":"8th Schedule = 22 languages","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-13","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"9th and 10th Schedules cover what (and via which amendments)?","back":"9th: land-reform laws (1st Amdt 1951); 10th: Anti-Defection (52nd Amdt 1985).","examPoint":"9th (land reforms) & 10th (anti-defection) Schedules","source":"notes","verified":true},
    {"id":"pol-constitution-features-preamble-card-14","subjectCode":"POL","subtopicId":"pol-constitution-features-preamble","front":"Parts: III, IV and IVA cover what?","back":"III = Fundamental Rights; IV = DPSP; IVA = Fundamental Duties (51A).","examPoint":"Parts III/IV/IVA — FR, DPSP, FD","source":"notes","verified":true}
  ]
}

     "id": "fr-over",
     "name": "Part III overview",
     "tag": "Overview",
     "rows": [
      {
       "k": "Where",
       "v": "Part III, Arts 12 – 35; \"Magna Carta of India\""
      },
      {
       "k": "Inspired",
       "v": "US Bill of Rights, UDHR"
      },
      {
       "k": "Six rights",
       "v": "Equality 14 – 18; Freedom 19 – 22; Exploitation 23 – 24; Religion 25 – 28; Culture-education 29 – 30; Remedies 32"
      },
      {
       "k": "Property",
       "v": "7th right; removed by 44th Amendment 1978 → Art 300A (Part XII)"
      },
      {
       "k": "Citizens only",
       "v": "15, 16, 19, 29, 30"
      },
      {
       "k": "All persons",
       "v": "14, 20, 21, 21A, 22, 23, 24, 25 – 28"
      },
      {
       "k": "vs DPSP",
       "v": "FRs justiciable, negative; DPSP non-justiciable, positive"
      }
     ]
    },
    {

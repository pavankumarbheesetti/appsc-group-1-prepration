       "k": "16(4A)",
       "v": "SC/ST promotion – 77th 1995; consequential seniority 85th 2001"
      },
      {
       "k": "16(4B)",
       "v": "Carry-forward beyond 50% – 81st 2000"
      },
      {
       "k": "16(5)",
       "v": "Religious-institution posts"
      }

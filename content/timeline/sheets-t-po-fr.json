     "name": "Articles 12 and 13",
     "tag": "Articles",
     "rows": [
      {
       "k": "Art 12 \"State\"",
       "v": "Union and state govts and legislatures, local bodies, other authorities under govt control"
      },
      {
       "k": "13(1)",
       "v": "Pre-1950 laws void if inconsistent"
      },
      {
       "k": "13(2)",
       "v": "No new law may abridge FRs"
      },
      {
       "k": "13(3)",
       "v": "\"Law\" includes ordinance, order, rule, notification, custom"
      },
      {
       "k": "Role",
       "v": "Basis of judicial review"
      },
      {
       "k": "Amendment as \"law\"",
       "v": "Shankari Prasad no; Golaknath yes; Kesavananda no but basic structure binds"
      }
     ]
    },
    {

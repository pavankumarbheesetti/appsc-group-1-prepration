   "keys": [
    {
     "id": "ca-368",
     "name": "Article 368 procedure",
     "tag": "Procedure",
     "rows": [
      {
       "k": "Where",
       "v": "Part XX; idea from South Africa"
      },
      {
       "k": "Start",
       "v": "Either House of Parliament, never a state; minister or private member; no prior President's nod"
      },
      {
       "k": "Passing",
       "v": "Each House separately; no joint sitting"
      },
      {
       "k": "Assent",
       "v": "Compulsory (24th, 1971); constituent power"
      },
      {
       "k": "States",
       "v": "Half the legislatures, simple majority, no time limit"
      },
      {
       "k": "Criticism",
       "v": "States cannot initiate (except Art 169); vague; no deadline"
      }
     ],
     "traps": [
      "Half the states, not all"
     ]
    },
    {
     "id": "ca-routes",
     "name": "Three routes",
     "tag": "Procedure",
     "rows": [
      {
       "k": "Simple (outside 368)",
       "v": "Arts 2, 3, 169; Second Schedule; quorum; MPs' pay; rules, privileges; English in Parliament; puisne SC judges; SC jurisdiction; citizenship; elections, delimitation; UTs; Fifth, Sixth Schedules"
      },
      {
       "k": "Special majority",
       "v": "FRs, DPSPs, everything else"
      },
      {
       "k": "Special + half states",
       "v": "President's election; Union and state executive power; SC, HCs; legislative lists; GST Council; Seventh Schedule; states in Parliament; Art 368 itself"
      }
     ]
    },

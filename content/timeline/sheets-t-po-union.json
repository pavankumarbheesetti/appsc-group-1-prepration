     "id": "un-pres-el",
     "name": "President – election and office",
     "tag": "President",
     "rows": [
      {
       "k": "Arts",
       "v": "52 office; 53 executive power; 54 – 55 election; 56 term 5 yrs; 57 re-election"
      },
      {
       "k": "College",
       "v": "Elected MPs + elected MLAs incl. Delhi, Puducherry (70th, 1992); not nominated, not MLCs"
      },
      {
       "k": "Vote value",
       "v": "MLA = population (1971) ÷ MLAs ÷ 1,000; MP = all MLA votes ÷ MPs"
      },
      {
       "k": "Method",
       "v": "PR by STV, secret ballot"
      },
      {
       "k": "Art 58",
       "v": "Citizen, 35, fit for Lok Sabha, no office of profit"
      },
      {
       "k": "Oath",
       "v": "CJI (Art 60); resigns to Vice-President"
      },
      {
       "k": "Disputes",
       "v": "Supreme Court (Art 71)"
      },
      {
       "k": "Immunity",
       "v": "Art 361 – no criminal case in term"
      }
     ]
    },
    {

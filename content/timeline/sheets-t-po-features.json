   "keys": [
    {
     "id": "pf-size",
     "name": "Size and form",
     "tag": "Features",
     "rows": [
      {
       "k": "Written",
       "v": "Yes (UK unwritten)"
      },
      {
       "k": "1949",
       "v": "Preamble, 395 Articles, 22 Parts, 8 Schedules"
      },
      {
       "k": "Now",
       "v": "~448 Articles (470 with lettered), 25 Parts, 12 Schedules (Oct 2024)"
      },
      {
       "k": "Amendments",
       "v": "106 by 2023 (women's reservation)"
      },
      {
       "k": "Why long",
       "v": "Diversity, 1935 Act, one constitution for all, lawyers in Assembly"
      }
     ]
    },
    {
     "id": "pf-amend",
     "name": "Rigid yet flexible",
     "tag": "Features",
     "rows": [
      {
       "k": "Special majority",
       "v": "Majority of total + 2/3 present and voting (Art 368)"
      },
      {
       "k": "Plus states",
       "v": "Above + half the state legislatures (federal matters)"
      },
      {
       "k": "Simple majority",
       "v": "Ordinary law, outside Art 368"
      }
     ],
     "traps": [
      "Special majority (368) ≠ simple majority"
     ]
    },
    {
     "id": "pf-fed",
     "name": "Federal with unitary bias",
     "tag": "Features",
     "rows": [
      {
       "k": "Federal",
       "v": "Two governments, division of powers, written, supreme, rigid, independent courts, bicameral"
      },
      {
       "k": "Unitary",
       "v": "Strong Centre, one constitution, single citizenship, integrated judiciary, Governors by Centre, AIS, emergencies"
      },
      {
       "k": "Art 1",
       "v": "\"Union of States\" – no agreement, no secession; word \"Federation\" absent"
      },
      {
       "k": "Labels",
       "v": "Wheare – quasi-federal; Austin – co-operative; Morris-Jones – bargaining; Jennings – strong centralising tendency"
      }
     ],
     "traps": [
      "Quasi-federal Wheare; co-operative Austin; bargaining Morris-Jones"
     ]
    },
    {
     "id": "pf-parl",
     "name": "Parliamentary system",
     "tag": "Features",
     "rows": [
      {
       "k": "Model",
       "v": "Westminster / cabinet / responsible government, Centre and states"
      },
      {
       "k": "Unlike UK",
       "v": "Parliament not sovereign; elected head of state"
      },
      {
       "k": "Synthesis",
       "v": "Parliamentary sovereignty + judicial supremacy"
      },
      {
       "k": "Art 21",
       "v": "Procedure established by law (Japan), not due process (USA)"
      },
      {
       "k": "Liberty safeguard",
       "v": "Separation of powers (UPSC 2021)"
      }
     ]
    },
    {
     "id": "pf-bodies",
     "name": "Independent bodies and emergencies",
     "tag": "Features",
     "rows": [
      {
       "k": "Bodies",
       "v": "Election Commission, CAG, UPSC (advises President), State PSC (advises Governor)"
      },
      {
       "k": "Not one",
       "v": "NITI Aayog – Cabinet resolution 2015"
      },
      {
       "k": "National Emergency",
       "v": "Art 352 – war, aggression, armed rebellion"
      },
      {
       "k": "President's Rule",
       "v": "Arts 356, 365"
      },
      {
       "k": "Financial",
       "v": "Art 360"
      }
     ],
     "traps": [
      "NITI Aayog is not constitutional"
     ]
    },
